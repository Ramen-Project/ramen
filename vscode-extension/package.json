{
  "name": "ramen-vscode",
  "displayName": "Ramen Visual Programming",
  "description": "Visual programming environment for Python with node-based graph editor",
  "version": "0.1.0",
  "publisher": "ramen",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Machine Learning",
    "Visualization"
  ],
  "keywords": [
    "ramen",
    "visual programming",
    "node editor",
    "python",
    "machine learning",
    "data science"
  ],
  "icon": "resources/ramen-icon.svg",
  "activationEvents": [
    "onLanguage:ramen",
    "onCommand:ramen.createNewGraph",
    "workspaceContains:**/*.ramen"
  ],
  "main": "./out/extension/extension.js",
  "browser": "./out/extension/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ramen",
        "aliases": [
          "Ramen",
          "ramen"
        ],
        "extensions": [
          ".ramen"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./resources/file-icon.svg",
          "dark": "./resources/file-icon.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "ramen.createNewGraph",
        "title": "Ramen: Create New Graph",
        "icon": "$(add)"
      },
      {
        "command": "ramen.executeGraph",
        "title": "Ramen: Execute Graph",
        "icon": "$(run)"
      },
      {
        "command": "ramen.manageProjectDependencies",
        "title": "Ramen: Manage Project Dependencies",
        "icon": "$(package)"
      },
      {
        "command": "ramen.stopServer",
        "title": "Ramen: Stop Server",
        "icon": "$(debug-stop)"
      },
      {
        "command": "ramen.restartServer",
        "title": "Ramen: Restart Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ramen.startServer",
        "title": "Ramen: Start Server",
        "icon": "$(debug-start)"
      },
      {
        "command": "ramen.refreshDependencies",
        "title": "Ramen: Refresh Dependencies",
        "icon": "$(refresh)"
      },
      {
        "command": "ramen.git.diff",
        "title": "Ramen: Show Git Diff",
        "icon": "$(git-compare)"
      },
      {
        "command": "ramen.git.status",
        "title": "Ramen: Git Status",
        "icon": "$(source-control)"
      },
      {
        "command": "ramen.git.log",
        "title": "Ramen: Git Log",
        "icon": "$(history)"
      },
      {
        "command": "ramen.git.merge",
        "title": "Ramen: Git Merge (Interactive)",
        "icon": "$(git-merge)"
      },
      {
        "command": "ramen.git.mergeHead",
        "title": "Ramen: Git Merge HEAD",
        "icon": "$(git-pull-request)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceExtname == .ramen",
          "command": "ramen.executeGraph",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .ramen && gitOpenRepositoryCount != 0",
          "command": "ramen.git.diff",
          "group": "1_git"
        }
      ],
      "explorer/context": [
        {
          "command": "ramen.createNewGraph",
          "when": "explorerResourceIsFolder",
          "group": "2_workspace@1"
        },
        {
          "command": "ramen.git.diff",
          "when": "resourceExtname == .ramen && gitOpenRepositoryCount != 0",
          "group": "7_modification"
        },
        {
          "command": "ramen.git.log",
          "when": "resourceExtname == .ramen && gitOpenRepositoryCount != 0",
          "group": "7_modification"
        },
        {
          "command": "ramen.git.merge",
          "when": "resourceExtname == .ramen && gitOpenRepositoryCount != 0",
          "group": "8_merge"
        },
        {
          "command": "ramen.git.mergeHead",
          "when": "resourceExtname == .ramen && gitOpenRepositoryCount != 0",
          "group": "8_merge"
        }
      ],
      "commandPalette": [],
      "view/title": [
        {
          "command": "ramen.startServer",
          "when": "view == ramenServer && !ramen:serverRunning",
          "group": "navigation"
        },
        {
          "command": "ramen.stopServer",
          "when": "view == ramenServer && ramen:serverRunning",
          "group": "navigation"
        },
        {
          "command": "ramen.restartServer",
          "when": "view == ramenServer",
          "group": "navigation"
        },
        {
          "command": "ramen.refreshDependencies",
          "when": "view == ramenDependencies",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ramen.executeGraph",
        "key": "f5",
        "when": "resourceExtname == .ramen"
      },
      {
        "command": "ramen.createNewGraph",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "configuration": {
      "title": "Ramen",
      "properties": {
        "ramen.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to Python interpreter for Ramen backend (leave empty to use system default)"
        },
        "ramen.serverPort": {
          "type": "number",
          "default": 8000,
          "description": "Port for Ramen backend server"
        },
        "ramen.autoStartServer": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Ramen server when opening a .ramen file"
        },
        "ramen.enableLanguageServer": {
          "type": "boolean",
          "default": true,
          "description": "Enable Language Server Protocol features for .ramen files"
        },
        "ramen.theme": {
          "type": "string",
          "enum": [
            "light",
            "dark",
            "auto"
          ],
          "default": "auto",
          "description": "UI theme for Ramen graph editor"
        },
        "ramen.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for troubleshooting"
        },
        "ramen.autoOpenEditor": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open graph editor when a .ramen file is selected"
        }
      }
    },
    "views": {
      "ramen": [
        {
          "id": "ramenVariables",
          "name": "Variables",
          "icon": "$(symbol-variable)",
          "contextualTitle": "Graph Variables",
          "when": "ramen:hasActiveGraph"
        },
        {
          "id": "ramenServer",
          "name": "Server",
          "icon": "$(server)",
          "contextualTitle": "Ramen Server Status"
        },
        {
          "id": "ramenDependencies",
          "name": "Dependencies",
          "icon": "$(package)",
          "contextualTitle": "Project Dependencies"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ramen",
          "title": "Ramen",
          "icon": "resources/ramen-icon.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "ramen.graphEditor",
        "displayName": "Ramen Graph Editor",
        "selector": [
          {
            "filenamePattern": "*.ramen"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build:all": "npm run build:webview && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "cd webview-build && bun run build",
    "test:webview": "cd webview-build && bun run test:run",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "./scripts/validate-extension.sh",
    "test:vscode": "node ./out/test/runTest.js",
    "test:all": "npm run test:webview && npm run test:vscode",
    "validate": "./scripts/validate-extension.sh",
    "clean": "rm -rf out && cd webview-build && rm -rf ../media/webview",
    "package": "npm run build:all && vsce package",
    "publish": "npm run build:all && vsce publish"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^8.56.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "nanoid": "^5.0.4",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "ws": "^8.18.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ramen.git"
  },
  "homepage": "https://github.com/yourusername/ramen#readme",
  "license": "MIT"
}
